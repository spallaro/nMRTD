<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Trimming friendliness: the ILLink trim analyzer works from net6.0 onward, so this applies
         to every target framework. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <InvariantGlobalization>true</InvariantGlobalization>

    <RootNamespace>nMRTD</RootNamespace>
    <AssemblyName>nMRTD</AssemblyName>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Native AOT is only officially supported by the SDK starting with .NET 7/8; net6.0 has no
       first-class PublishAot/AOT-analyzer support, so these apply to the net8.0 and net10.0 targets.
       net8.0 is out of support but kept so that .NET 8 and 9 apps get an AOT-compatible build. -->
  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>nMRTD</PackageId>
    <Version>0.8.8-alpha</Version>
    <Title>nMRTD</Title>
    <Description>.NET 6/8/10 port of JMRTD for reading ICAO 9303 electronic travel documents (ePassports, eID cards) with contactless PC/SC readers: BAC, PACE, EAC, Active and Passive Authentication, and ISO/IEC 19794 and 39794 biometrics. Native AOT compatible.</Description>
    <Authors>Sebastiano Pallaro</Authors>
    <Copyright>(C) 2026 Sebastiano Pallaro</Copyright>
    <PackageTags>mrtd emrtd epassport eid</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>nMRTD.png</PackageIcon>
    <RepositoryUrl>https://github.com/spallaro/nMRTD</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/spallaro/nMRTD</PackageProjectUrl>
  </PropertyGroup>

  <!-- Debugging support for package consumers (NuGet Package Explorer health checks). Source Link
       (built into the .NET 8+ SDK) records the GitHub commit and URLs of the sources; the PDB is
       embedded in the DLL, so symbols and compiler flags ship with the package itself, with no
       separate .snupkg to upload. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Build the .nupkg automatically, but only for Release builds. -->
  <!-- Release builds are deterministic CI builds: local paths are normalized (/_/), so the same commit
       always produces the same DLL. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Lets the test project reach internal members. Only for unsigned builds: a strong-named assembly
       would need the test assembly's public key here, and the signed release build does not need it. -->
  <ItemGroup Condition="'$(SignAssembly)' != 'true'">
    <InternalsVisibleTo Include="nMRTD.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="PCSC" Version="7.0.1" />
    <PackageReference Include="PCSC.Iso7816" Version="7.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\nMRTD.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
