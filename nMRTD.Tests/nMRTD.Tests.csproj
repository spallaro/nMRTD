<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;net472;net6.0;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <RootNamespace>nMRTD.Tests</RootNamespace>
    <AssemblyName>nMRTD.Tests</AssemblyName>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)coverage.runsettings</RunSettingsFilePath>

    <!-- net6.0 is out of support but still a target of the library, so it is tested too. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>

    <!-- The tests exercise some APIs that are marked obsolete. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <!-- .NET Framework: the tests' RuntimeHelpers.GetSubArray polyfill hides the framework type (see
       Helpers/NetFrameworkTestCompat.cs). -->
  <PropertyGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\nMRTD\nMRTD.csproj" />
  </ItemGroup>

  <!-- The command-line tool targets .NET 6/8/10 only: its tests run there. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <ProjectReference Include="..\nMRTD.Cli\nMRTD.Cli.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Compile Remove="Cli\**" />
    <Using Remove="System.Net.Http" />
    <Using Include="nMRTD.Compat" />
    <Using Include="nMRTD.Tests.Helpers" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="certs\**\*.cvcert" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fixtures\**\*" Exclude="fixtures\README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
